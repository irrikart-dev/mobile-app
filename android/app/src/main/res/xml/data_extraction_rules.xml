<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup is ignored for device-to-device transfer, so
     exclude everything explicitly. Session state must never be restored onto
     a device that doesn't hold its Keystore key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
